@prefix cap:  <https://hcis.io/ontology/aicapstone/2026/> .
@prefix g09:  <https://hcis.io/ontology/aicapstone/2026/group09/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

<https://hcis.io/ontology/aicapstone/2026/group09/>
    a owl:Ontology ;
    rdfs:label "AI Capstone 2026 Group 09 Ontology"@en ;
    rdfs:comment "Group 09 ontology for baseline semantic grounding and inferred graspability over the course object vocabulary."@en ;
    dcterms:title "AI Capstone 2026 Group 09 Ontology"@en ;
    dcterms:description "Group 09 model for the AI Capstone 2026 homework 5 semantic grounding task, including task instances, affordance individuals, and graspability-ready assertions."@en ;
    dcterms:creator g09:group09Team ;
    dcterms:created "2026-05-27"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "g09" ;
    vann:preferredNamespaceUri "https://hcis.io/ontology/aicapstone/2026/group09/" ;
    owl:imports <imports/course-affordance.ttl> .

g09:group09Team
    a foaf:Organization ;
    rdfs:label "Group 09"@en ;
    rdfs:comment "The student group responsible for this ontology submission."@en .

# ── Class definition: GraspableObject (Section 11 of homework) ─────

cap:GraspableObject
    a owl:Class ;
    rdfs:label "graspable object"@en ;
    rdfs:comment
        "A physical object that has at least one grasping affordance and can therefore be grasped by a robot gripper. Defined as the intersection of cap:PhysicalObject and the existential restriction cap:hasAffordance some cap:GraspingAffordance."@en ;
    rdfs:subClassOf cap:PhysicalObject ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            cap:PhysicalObject
            [ a owl:Restriction ;
              owl:onProperty cap:hasAffordance ;
              owl:someValuesFrom cap:GraspingAffordance
            ]
        )
    ] .

g09:PressableObject
    a owl:Class ;
    rdfs:label "pressable object"@en ;
    rdfs:comment
        "A physical object that has at least one pressing affordance and can therefore be pressed by a robot in the task context."@en ;
    rdfs:subClassOf cap:PhysicalObject ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            cap:PhysicalObject
            [ a owl:Restriction ;
              owl:onProperty cap:hasAffordance ;
              owl:someValuesFrom g09:PressingAffordance
            ]
        )
    ] .

# ── Group-specific properties ──────────────────────────────────────

g09:usedInTask
    a owl:ObjectProperty ;
    rdfs:domain cap:PhysicalObject ;
    rdfs:range cap:ManipulationTask ;
    rdfs:label "used in task"@en ;
    rdfs:comment "Relates a physical object to the manipulation task in which it participates."@en .

g09:hasGripWidthMM
    a owl:DatatypeProperty ;
    rdfs:domain cap:PhysicalObject ;
    rdfs:range xsd:decimal ;
    rdfs:label "has grip width in millimeters"@en ;
    rdfs:comment "Records the approximate grip width in millimeters required to grasp this object with the group 09 gripper."@en .

# ── Task instances ─────────────────────────────────────────────────

g09:cupStackingTask
    a cap:ManipulationTask ;
    rdfs:label "cup stacking task"@en ;
    rdfs:comment "The baseline task where the robot stacks the blue cup on top of the pink cup."@en ;
    cap:hasTargetObject g09:blueCup01 , g09:pinkCup01 .

g09:cutleryArrangementTask
    a cap:ManipulationTask ;
    rdfs:label "cutlery arrangement task"@en ;
    rdfs:comment "The baseline task where the robot arrange the fork and knife on the right and left side of the plate, respectively, within a limited distance."@en ;
    cap:hasTargetObject g09:knife01 , g09:fork01 ;
    cap:hasReferenceObject g09:plate01 .

g09:blockCollectionTask
    a cap:ManipulationTask ;
    rdfs:label "toy block collection task"@en ;
    rdfs:comment "The baseline task where the robot collect all the blocks within (x,y,z)_range of the storage_box."@en ;
    cap:hasTargetObject g09:block01 .

g09:pumpBottlePressTask
    a cap:ManipulationTask ;
    rdfs:label "pump bottle press task"@en ;
    rdfs:comment "The advanced manipulation task, where the robot presses down the pump bottle and release while keeping the bottle upright."@en ;
    cap:hasTargetObject g09:pumpBottle01 .

# ── End effector ───────────────────────────────────────────────────

g09:gripper01
    a cap:EndEffector ;
    rdfs:label "group 09 gripper"@en ;
    rdfs:comment "The gripper used as the manipulation end effector in the environment."@en .

# ── Group-specific classes ─────────────────────────────────────────

g09:PumpBottle
    a owl:Class ;
    rdfs:subClassOf cap:PhysicalObject ;
    rdfs:label "pump bottle"@en ;
    rdfs:comment "An advanced-level articulated bottle-shaped object with a pressable pump head, aligned with the aicapstone pump_bottle object."@en .

g09:PressingAffordance
    a owl:Class ;
    rdfs:subClassOf cap:Affordance ;
    rdfs:label "pressing affordance"@en ;
    rdfs:comment "An affordance by which an articulated object can be pressed along a task-relevant joint while remaining stable."@en .

# ── Object individuals ─────────────────────────────────────────────

g09:blueCup01
    a cap:Cup ;
    rdfs:label "blue cup 01"@en ;
    rdfs:comment "The blue cup observed in the cup-stacking task."@en ;
    cap:hasColor "blue" ;
    cap:hasObjectLabel "blue_cup" ;
    cap:hasTaskRole cap:TargetObject ;
    cap:hasPoseFrame "world/object_blue_cup_01" ;
    cap:hasAffordance g09:blueCup01GraspingAffordance , g09:blueCup01StackabilityAffordance ;
    cap:canBeManipulatedBy g09:gripper01 ;
    g09:usedInTask g09:cupStackingTask ;
    g09:hasGripWidthMM "75"^^xsd:decimal .

g09:blueCup01GraspingAffordance
    a cap:GraspingAffordance ;
    rdfs:label "blue cup 01 grasping affordance"@en ;
    rdfs:comment "A grasping affordance associated with the blue cup."@en .

g09:blueCup01StackabilityAffordance
    a cap:StackabilityAffordance ;
    rdfs:label "blue cup 01 stackability affordance"@en ;
    rdfs:comment "A stackability affordance associated with the blue cup."@en .

g09:pinkCup01
    a cap:Cup ;
    rdfs:label "pink cup 01"@en ;
    rdfs:comment "The pink cup observed in the cup-stacking task."@en ;
    cap:hasColor "pink" ;
    cap:hasObjectLabel "pink_cup" ;
    cap:hasTaskRole cap:TargetObject ;
    cap:hasPoseFrame "world/object_pink_cup_01" ;
    cap:hasAffordance g09:pinkCup01GraspingAffordance , g09:pinkCup01StackabilityAffordance ;
    cap:canBeManipulatedBy g09:gripper01 ;
    g09:usedInTask g09:cupStackingTask ;
    g09:hasGripWidthMM "75"^^xsd:decimal .

g09:pinkCup01GraspingAffordance
    a cap:GraspingAffordance ;
    rdfs:label "pink cup 01 grasping affordance"@en ;
    rdfs:comment "A grasping affordance associated with the pink cup."@en .

g09:pinkCup01StackabilityAffordance
    a cap:StackabilityAffordance ;
    rdfs:label "pink cup 01 stackability affordance"@en ;
    rdfs:comment "A stackability affordance associated with the pink cup."@en .

g09:knife01
    a cap:Knife ;
    rdfs:label "knife 01"@en ;
    rdfs:comment "The knife observed in the cutlery-arrangement task."@en ;
    cap:hasColor "silver" ;
    cap:hasObjectLabel "knife" ;
    cap:hasTaskRole cap:TargetObject ;
    cap:hasPoseFrame "world/object_knife_01" ;
    cap:hasAffordance g09:knife01GraspingAffordance ;
    cap:canBeManipulatedBy g09:gripper01 ;
    g09:usedInTask g09:cutleryArrangementTask ;
    g09:hasGripWidthMM "20"^^xsd:decimal .

g09:knife01GraspingAffordance
    a cap:GraspingAffordance ;
    rdfs:label "knife 01 grasping affordance"@en ;
    rdfs:comment "A grasping affordance associated with the knife."@en .

g09:fork01
    a cap:Fork ;
    rdfs:label "fork 01"@en ;
    rdfs:comment "The fork observed in the cutlery-arrangement task."@en ;
    cap:hasColor "silver" ;
    cap:hasObjectLabel "fork" ;
    cap:hasTaskRole cap:TargetObject ;
    cap:hasPoseFrame "world/object_fork_01" ;
    cap:hasAffordance g09:fork01GraspingAffordance ;
    cap:canBeManipulatedBy g09:gripper01 ;
    g09:usedInTask g09:cutleryArrangementTask ;
    g09:hasGripWidthMM "20"^^xsd:decimal .

g09:fork01GraspingAffordance
    a cap:GraspingAffordance ;
    rdfs:label "fork 01 grasping affordance"@en ;
    rdfs:comment "A grasping affordance associated with the fork."@en .

g09:plate01
    a cap:Plate ;
    rdfs:label "plate 01"@en ;
    rdfs:comment "The plate used as a reference object in the cutlery-arrangement task."@en ;
    cap:hasColor "white" ;
    cap:hasObjectLabel "plate" ;
    cap:hasTaskRole cap:ReferenceObject ;
    cap:hasPoseFrame "world/object_plate_01" ;
    cap:hasAffordance g09:plate01SupportAffordance ;
    g09:usedInTask g09:cutleryArrangementTask .

g09:plate01SupportAffordance
    a cap:SupportAffordance ;
    rdfs:label "plate 01 support affordance"@en ;
    rdfs:comment "A support affordance associated with the plate."@en .

g09:block01
    a cap:ToyBlock ;
    rdfs:label "toy block 01"@en ;
    rdfs:comment "A toy block collected into the basket in the toy-block-collection task."@en ;
    cap:hasColor "red" ;
    cap:hasObjectLabel "toy_block" ;
    cap:hasTaskRole cap:CollectableObject ;
    cap:hasPoseFrame "world/object_block_01" ;
    cap:hasAffordance g09:block01GraspingAffordance ;
    cap:canBeManipulatedBy g09:gripper01 ;
    g09:usedInTask g09:blockCollectionTask ;
    g09:hasGripWidthMM "40"^^xsd:decimal .

g09:block01GraspingAffordance
    a cap:GraspingAffordance ;
    rdfs:label "toy block 01 grasping affordance"@en ;
    rdfs:comment "A grasping affordance associated with the toy block."@en .

g09:basket01
    a cap:Basket ;
    rdfs:label "basket 01"@en ;
    rdfs:comment "The basket used as the container target in the toy-block-collection task."@en ;
    cap:hasColor "brown" ;
    cap:hasObjectLabel "basket" ;
    cap:hasTaskRole cap:ContainerTarget ;
    cap:hasPoseFrame "world/object_basket_01" ;
    cap:hasAffordance g09:basket01ContainmentAffordance ;
    g09:usedInTask g09:blockCollectionTask .

g09:basket01ContainmentAffordance
    a cap:ContainmentAffordance ;
    rdfs:label "basket 01 containment affordance"@en ;
    rdfs:comment "A containment affordance associated with the basket."@en .

g09:pumpBottle01
    a g09:PumpBottle ;
    rdfs:label "pump bottle 01"@en ;
    rdfs:comment "The advanced-level pump bottle used in the pump bottle press task, matching the aicapstone object label pump_bottle."@en ;
    cap:hasColor "white" ;
    cap:hasObjectLabel "pump_bottle" ;
    cap:hasTaskRole cap:TargetObject ;
    cap:hasPoseFrame "world/object_pump_bottle_01" ;
    cap:hasAffordance g09:pumpBottle01PressingAffordance ;
    cap:canBeManipulatedBy g09:gripper01 ;
    g09:usedInTask g09:pumpBottlePressTask .

g09:pumpBottle01PressingAffordance
    a g09:PressingAffordance ;
    rdfs:label "pump bottle 01 pressing affordance"@en ;
    rdfs:comment "A pressing affordance associated with the pump bottle, modeled after the aicapstone pump_bottle_press task where the pump head is pressed once while the bottle remains stable."@en .

g09:pumpBottlePressTask
    a cap:ManipulationTask ;
    rdfs:label "pump bottle press task"@en ;
    rdfs:comment
        "The advanced pump bottle pressing task."@en .

g09:pumpBottle01
    a g09:PumpBottle ;
    cap:hasAffordance g09:pumpBottlePressingAffordance ;
    cap:hasTaskRole cap:TargetObject ;
    g09:usedInTask g09:pumpBottlePressTask ;
    cap:hasColor "white" ;
    cap:hasObjectLabel "pump_bottle" ;
    cap:hasPoseFrame "world/object_pump_bottle_01" ;
    rdfs:label "pump bottle 01"@en ;
    rdfs:comment
        "The pump bottle used in the advanced pressing task."@en .

g09:pumpBottlePressingAffordance
    a g09:PressingAffordance ;
    rdfs:label "pump bottle pressing affordance"@en ;
    rdfs:comment
        "The pressing affordance associated with the pump bottle."@en .
