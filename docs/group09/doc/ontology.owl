<?xml version="1.0"?>
<rdf:RDF xmlns="https://hcis.io/ontology/aicapstone/2026/group09/"
     xml:base="https://hcis.io/ontology/aicapstone/2026/group09/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:group09="https://hcis.io/ontology/aicapstone/2026/group09/"
     xmlns:aicapstone="https://hcis.io/ontology/aicapstone/2026/">
    <owl:Ontology rdf:about="https://hcis.io/ontology/aicapstone/2026/group09/">
        <owl:imports rdf:resource="file:/G:/學校/114-2/人工智慧/HW5/AI_capstone_hw5/ontology/imports/course-affordance.ttl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-27</terms:created>
        <terms:creator rdf:resource="https://hcis.io/ontology/aicapstone/2026/group09/group09Team"/>
        <terms:description xml:lang="en">Group 09 model for the AI Capstone 2026 homework 5 semantic grounding task, including task instances, affordance individuals, and graspability-ready assertions.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">AI Capstone 2026 Group 09 Ontology</terms:title>
        <vann:preferredNamespacePrefix>g09</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://hcis.io/ontology/aicapstone/2026/group09/</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Group 09 ontology for baseline semantic grounding and inferred graspability over the course object vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="en">AI Capstone 2026 Group 09 Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://hcis.io/ontology/aicapstone/2026/group09/usedInTask -->


    <owl:ObjectProperty rdf:about="https://hcis.io/ontology/aicapstone/2026/group09/usedInTask">
        <rdfs:domain rdf:resource="https://hcis.io/ontology/aicapstone/2026/PhysicalObject"/>
        <rdfs:range rdf:resource="https://hcis.io/ontology/aicapstone/2026/ManipulationTask"/>
        <rdfs:comment xml:lang="en">Relates a physical object to the manipulation task in which it participates.</rdfs:comment>
        <rdfs:label xml:lang="en">used in task</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://hcis.io/ontology/aicapstone/2026/group09/hasGripWidthMM -->


    <owl:DatatypeProperty rdf:about="https://hcis.io/ontology/aicapstone/2026/group09/hasGripWidthMM">
        <rdfs:domain rdf:resource="https://hcis.io/ontology/aicapstone/2026/PhysicalObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Records the approximate grip width in millimeters required to grasp this object with the group 09 gripper.</rdfs:comment>
        <rdfs:label xml:lang="en">has grip width in millimeters</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://xmlns.com/foaf/0.1/Organization -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
    


    <!-- https://hcis.io/ontology/aicapstone/2026/GraspableObject -->


    <owl:Class rdf:about="https://hcis.io/ontology/aicapstone/2026/GraspableObject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://hcis.io/ontology/aicapstone/2026/PhysicalObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://hcis.io/ontology/aicapstone/2026/hasAffordance"/>
                        <owl:someValuesFrom rdf:resource="https://hcis.io/ontology/aicapstone/2026/GraspingAffordance"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://hcis.io/ontology/aicapstone/2026/PhysicalObject"/>
        <rdfs:comment xml:lang="en">A physical object that has at least one grasping affordance and can therefore be grasped by a robot gripper. Defined as the intersection of cap:PhysicalObject and the existential restriction cap:hasAffordance some cap:GraspingAffordance.</rdfs:comment>
        <rdfs:label xml:lang="en">graspable object</rdfs:label>
    </owl:Class>
    


    <!-- https://hcis.io/ontology/aicapstone/2026/group09/PressableObject -->


    <owl:Class rdf:about="https://hcis.io/ontology/aicapstone/2026/group09/PressableObject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://hcis.io/ontology/aicapstone/2026/PhysicalObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://hcis.io/ontology/aicapstone/2026/hasAffordance"/>
                        <owl:someValuesFrom rdf:resource="https://hcis.io/ontology/aicapstone/2026/group09/PressingAffordance"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://hcis.io/ontology/aicapstone/2026/PhysicalObject"/>
        <rdfs:comment xml:lang="en">A physical object that has at least one pressing affordance and can therefore be pressed by a robot in the task context.</rdfs:comment>
        <rdfs:label xml:lang="en">pressable object</rdfs:label>
    </owl:Class>
    


    <!-- https://hcis.io/ontology/aicapstone/2026/group09/PressingAffordance -->


    <owl:Class rdf:about="https://hcis.io/ontology/aicapstone/2026/group09/PressingAffordance">
        <rdfs:subClassOf rdf:resource="https://hcis.io/ontology/aicapstone/2026/Affordance"/>
        <rdfs:comment xml:lang="en">An affordance by which an articulated object can be pressed along a task-relevant joint while remaining stable.</rdfs:comment>
        <rdfs:label xml:lang="en">pressing affordance</rdfs:label>
    </owl:Class>
    


    <!-- https://hcis.io/ontology/aicapstone/2026/group09/PumpBottle -->


    <owl:Class rdf:about="https://hcis.io/ontology/aicapstone/2026/group09/PumpBottle">
        <rdfs:subClassOf rdf:resource="https://hcis.io/ontology/aicapstone/2026/PhysicalObject"/>
        <rdfs:comment xml:lang="en">An advanced-level articulated bottle-shaped object with a pressable pump head, aligned with the aicapstone pump_bottle object.</rdfs:comment>
        <rdfs:label xml:lang="en">pump bottle</rdfs:label>
    </owl:Class>
    


