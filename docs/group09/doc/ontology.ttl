                                                     rdfs:comment "Group 09 ontology for baseline semantic grounding and inferred graspability over the course object vocabulary."@en ;
                                                     rdfs:label "AI Capstone 2026 Group 09 Ontology"@en .

#################################################################
#    Object Properties
#################################################################

###  https://hcis.io/ontology/aicapstone/2026/group09/usedInTask
:usedInTask rdf:type owl:ObjectProperty ;
            rdfs:domain <https://hcis.io/ontology/aicapstone/2026/PhysicalObject> ;
            rdfs:range <https://hcis.io/ontology/aicapstone/2026/ManipulationTask> ;
            rdfs:comment "Relates a physical object to the manipulation task in which it participates."@en ;
            rdfs:label "used in task"@en .


#################################################################
#    Data properties
#################################################################

###  https://hcis.io/ontology/aicapstone/2026/group09/hasGripWidthMM
:hasGripWidthMM rdf:type owl:DatatypeProperty ;
                rdfs:domain <https://hcis.io/ontology/aicapstone/2026/PhysicalObject> ;
                rdfs:range xsd:decimal ;
                rdfs:comment "Records the approximate grip width in millimeters required to grasp this object with the group 09 gripper."@en ;
                rdfs:label "has grip width in millimeters"@en .


#################################################################
#    Classes
#################################################################

###  http://xmlns.com/foaf/0.1/Organization
<http://xmlns.com/foaf/0.1/Organization> rdf:type owl:Class .


###  https://hcis.io/ontology/aicapstone/2026/GraspableObject
<https://hcis.io/ontology/aicapstone/2026/GraspableObject> rdf:type owl:Class ;
                                                           owl:equivalentClass [ owl:intersectionOf ( <https://hcis.io/ontology/aicapstone/2026/PhysicalObject>
                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty <https://hcis.io/ontology/aicapstone/2026/hasAffordance> ;
                                                                                                        owl:someValuesFrom <https://hcis.io/ontology/aicapstone/2026/GraspingAffordance>
                                                                                                      ]
                                                                                                    ) ;
                                                                                 rdf:type owl:Class
                                                                               ] ;
                                                           rdfs:subClassOf <https://hcis.io/ontology/aicapstone/2026/PhysicalObject> ;
                                                           rdfs:comment "A physical object that has at least one grasping affordance and can therefore be grasped by a robot gripper. Defined as the intersection of cap:PhysicalObject and the existential restriction cap:hasAffordance some cap:GraspingAffordance."@en ;
                                                           rdfs:label "graspable object"@en .


###  https://hcis.io/ontology/aicapstone/2026/group09/PressableObject
:PressableObject rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( <https://hcis.io/ontology/aicapstone/2026/PhysicalObject>
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://hcis.io/ontology/aicapstone/2026/hasAffordance> ;
                                                              owl:someValuesFrom :PressingAffordance
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf <https://hcis.io/ontology/aicapstone/2026/PhysicalObject> ;
                 rdfs:comment "A physical object that has at least one pressing affordance and can therefore be pressed by a robot in the task context."@en ;
                 rdfs:label "pressable object"@en .


###  https://hcis.io/ontology/aicapstone/2026/group09/PressingAffordance
:PressingAffordance rdf:type owl:Class ;
                    rdfs:subClassOf <https://hcis.io/ontology/aicapstone/2026/Affordance> ;
                    rdfs:comment "An affordance by which an articulated object can be pressed along a task-relevant joint while remaining stable."@en ;
                    rdfs:label "pressing affordance"@en .


###  https://hcis.io/ontology/aicapstone/2026/group09/PumpBottle
:PumpBottle rdf:type owl:Class ;
            rdfs:subClassOf <https://hcis.io/ontology/aicapstone/2026/PhysicalObject> ;
            rdfs:comment "An advanced-level articulated bottle-shaped object with a pressable pump head, aligned with the aicapstone pump_bottle object."@en ;
            rdfs:label "pump bottle"@en .


