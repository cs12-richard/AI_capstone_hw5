<https://hcis.io/ontology/aicapstone/2026/group09/> rdf:type owl:Ontology ;
                                                     owl:imports <file:/G:/學校/114-2/人工智慧/HW5/AI_capstone_hw5/ontology/imports/course-affordance.ttl> ;
                                                     <http://purl.org/dc/terms/created> "2026-05-27"^^xsd:date ;
                                                     <http://purl.org/dc/terms/creator> :group09Team ;
                                                     <http://purl.org/dc/terms/description> "Group 09 model for the AI Capstone 2026 homework 5 semantic grounding task, including task instances, affordance individuals, and graspability-ready assertions."@en ;
